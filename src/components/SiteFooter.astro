---
import { getSiteSettings } from '../lib/sanity';

const settings = await getSiteSettings();
---

<footer class="site-footer">
  <div class="shell">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <img
          src="/assets/source/5b070d9e-9a82-4903-8ece-d2f822c17788.png"
          alt="DMG Blockchain Solutions"
          width="546"
          height="249"
        />
        <p>Canadian digital infrastructure and blockchain technology.</p>
        <p class="market-codes">TSXV: DMGI<br />OTCQB: DMGGF</p>
      </div>

      <nav aria-labelledby="footer-company">
        <p id="footer-company" class="footer-label">Company</p>
        <a href="/about">About DMG</a>
        <a href="/about#leadership">Leadership</a>
        <a href="https://www.dmgblockchain.com/careers" target="_blank" rel="noopener noreferrer">Careers</a>
        <a href="/contact">Contact</a>
      </nav>

      <nav aria-labelledby="footer-infrastructure">
        <p id="footer-infrastructure" class="footer-label">Infrastructure</p>
        <a href="/#spotlight">Data Centers</a>
        <a href="/ai-transition">AI and HPC</a>
        <a href="/#infrastructure">Bitcoin Mining</a>
        <a href="/#infrastructure">Colocation</a>
      </nav>

      <nav aria-labelledby="footer-resources">
        <p id="footer-resources" class="footer-label">Resources</p>
        <div class="footer-featured-resource">
          <span>Featured resource</span>
          <a href="/ai-transition">Christina Lake AI Update <span aria-hidden="true">→</span></a>
        </div>
        <a href="/insights">Insights</a>
        <a href="https://www.dmgblockchain.com/dmg-in-the-media" target="_blank" rel="noopener noreferrer">Media</a>
        <a href="/financial">Financials</a>
        <a href="/presentation">Presentation</a>
        <a href="/events">Events</a>
        <a href="https://www.sedarplus.ca" target="_blank" rel="noopener noreferrer">SEDAR+</a>
      </nav>

      <nav aria-labelledby="footer-legal">
        <p id="footer-legal" class="footer-label">Legal</p>
        <a href="/privacy-policy">Privacy</a>
        <a href="/terms-of-service">Terms</a>
        <a href="/disclaimer">Disclaimer</a>
        <a href="/modern-slavery">Modern Slavery</a>
        <a href={settings.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={settings.xUrl} target="_blank" rel="noopener noreferrer">X</a>
      </nav>
    </div>

    <div class="site-footer__legal">
      <p>© 2026 DMG Blockchain Solutions Inc. Incorporated in British Columbia, Canada.</p>
      <p>Nothing on this site is an offer to sell securities or a forecast of financial performance.</p>
    </div>
  </div>
</footer>
