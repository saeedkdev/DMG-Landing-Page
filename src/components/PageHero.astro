---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="page-hero">
  <div class="shell page-hero__inner">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span><span>{eyebrow}</span>
    </nav>
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {description && <p class="page-hero__lede">{description}</p>}
  </div>
</header>
