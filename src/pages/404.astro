---
import SiteLayout from '../layouts/SiteLayout.astro';

export const prerender = true;
Astro.response.status = 404;
---

<SiteLayout title="Page not found | DMG Blockchain Solutions" description="The requested page could not be found." canonicalPath="/404">
  <section class="not-found"><div class="shell"><p class="eyebrow">404 / Page not found</p><h1>This route ends here. The infrastructure does not.</h1><p>The page may have moved or the address may be incomplete.</p><div><a class="blueprint-button" href="/">Return home</a><a href="/insights">Browse insights →</a></div></div></section>
</SiteLayout>
