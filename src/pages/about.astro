---
import PageHero from '../components/PageHero.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getAboutPage } from '../lib/sanity';

export const prerender = true;
const page = await getAboutPage();
const initials = (name: string) => name.split(/\s+/).map((part) => part[0]).join('').slice(0, 2).toUpperCase();
---

<SiteLayout title="About DMG | DMG Blockchain Solutions" description={page.intro} canonicalPath="/about" current="about">
  <PageHero eyebrow={page.eyebrow} title={page.title} description={page.intro} />

  <section class="about-strategy" aria-labelledby="pillars-title">
    <div class="shell">
      <div class="section-heading"><h2 id="pillars-title">Our strategic pillars.</h2></div>
      <div class="strategy-grid">
        <article>
          <div class="strategy-grid__visual"><img src={page.coreImageUrl || '/assets/about/core-white.avif'} alt="DMG Core data center infrastructure strategy" /></div>
          <p class="eyebrow">Core</p>
          <h3>{page.coreTitle}</h3>
          <p>{page.coreDescription}</p>
        </article>
        <article>
          <div class="strategy-grid__visual"><img src={page.corePlusImageUrl || '/assets/about/core-plus-white.avif'} alt="DMG Core+ software and services strategy" /></div>
          <p class="eyebrow">Core+</p>
          <h3>{page.corePlusTitle}</h3>
          <p>{page.corePlusDescription}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="milestone-section" aria-labelledby="milestones-title">
    <div class="shell">
      <div class="section-heading"><h2 id="milestones-title">{page.milestonesTitle}</h2></div>
      <figure><img src={page.milestonesImageUrl || '/assets/about/milestone-desktop.avif'} alt="Timeline of DMG Blockchain Solutions milestones" /></figure>
    </div>
  </section>

  <section id="leadership" class="leadership-section" aria-labelledby="management-title">
    <div class="shell">
      <div class="leadership-intro">
        <p class="eyebrow">Our people</p>
        <h2 id="management-title">{page.managementTitle}</h2>
        <p>Experienced operators building DMG’s infrastructure, software and digital-asset businesses.</p>
      </div>

      <div class="people-grid">
        {page.managementTeam.map((person) => (
          <article class="person-card">
            <div class:list={["person-card__portrait", { "person-card__portrait--photo": person.photoUrl }]}>
              {person.photoUrl ? <img src={person.photoUrl} alt="" /> : <span aria-hidden="true">{initials(person.name)}</span>}
            </div>
            <div class="person-card__copy">
              <h3>{person.name}</h3>
              <p>{person.role}</p>
              {person.linkedinUrl && (
                <a href={person.linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label={`${person.name} on LinkedIn`}>
                  LinkedIn <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>

      <div class="board-heading">
        <p class="eyebrow">Governance</p>
        <h2>{page.boardTitle}</h2>
      </div>
      <div class="people-grid people-grid--board">
        {page.boardMembers.map((person) => (
          <article class="person-card person-card--compact">
            <div class:list={["person-card__portrait", { "person-card__portrait--photo": person.photoUrl }]}>
              {person.photoUrl ? <img src={person.photoUrl} alt="" /> : <span aria-hidden="true">{initials(person.name)}</span>}
            </div>
            <div class="person-card__copy">
              <h3>{person.name}</h3>
              <p>{person.role}</p>
              {person.linkedinUrl && (
                <a href={person.linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label={`${person.name} on LinkedIn`}>
                  LinkedIn <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="article-signoff"><div class="shell"><h2>Built through vertical integration.</h2><a class="blueprint-button" href="/contact">Talk with DMG</a></div></section>
</SiteLayout>
