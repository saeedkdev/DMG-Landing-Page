---
import LegalDocument from '../components/LegalDocument.astro'; import PageHero from '../components/PageHero.astro'; import SiteLayout from '../layouts/SiteLayout.astro'; import { getLegalPage } from '../lib/sanity';
export const prerender = true; const page = await getLegalPage('disclaimer'); if (!page) throw new Error('Disclaimer is missing from Sanity.');
---
<SiteLayout title="Disclaimer | DMG Blockchain Solutions" description="DMG Blockchain Solutions website disclaimer." canonicalPath="/disclaimer"><PageHero eyebrow="Legal" title={page.title} /><LegalDocument page={page} /></SiteLayout>
