---
import InsightCard from '../../components/InsightCard.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getBeehiivArticles, type BeehiivBlogPost } from '../../lib/beehiiv';

interface Props {
  post: BeehiivBlogPost;
  relatedPosts: BeehiivBlogPost[];
}

export async function getStaticPaths() {
  const posts = await getBeehiivArticles();

  return posts.map((post) => {
    const relatedPosts = posts
      .filter((candidate) => candidate.id !== post.id)
      .sort((left, right) => Number(right.cat === post.cat) - Number(left.cat === post.cat))
      .slice(0, 3);

    return {
      params: { slug: post.slug },
      props: { post, relatedPosts },
    };
  });
}

const { post, relatedPosts } = Astro.props;
const pageTitle = `${post.title} | DMG Insights`;
const canonicalUrl = new URL(post.url, Astro.site ?? Astro.url.origin);
const shareUrl = encodeURIComponent(canonicalUrl.href);
const shareTitle = encodeURIComponent(post.title);
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.excerpt,
  image: post.thumbnail || undefined,
  datePublished: post.publishedAt,
  dateModified: post.publishedAt,
  author: {
    '@type': 'Organization',
    name: post.author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'DMG Blockchain Solutions Inc.',
    logo: {
      '@type': 'ImageObject',
      url: new URL(
        '/assets/source/5b070d9e-9a82-4903-8ece-d2f822c17788.png',
        Astro.site ?? Astro.url.origin,
      ).href,
    },
  },
  mainEntityOfPage: canonicalUrl.href,
}).replace(/</g, '\\u003c');
---

<SiteLayout
  title={pageTitle}
  description={post.excerpt}
  image={post.thumbnail}
  canonicalPath={post.url}
  type="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.publishedAt} />
    <meta property="article:section" content={post.cat} />
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
  </Fragment>

  <article>
    <header class="article-hero">
      <div class="shell article-hero__inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/insights">Insights</a>
          <span aria-hidden="true">/</span>
          <span>{post.cat}</span>
        </nav>

        <p class="eyebrow">{post.cat}</p>
        <h1>{post.title}</h1>
        <p class="article-hero__lede">{post.excerpt}</p>
        <div class="article-meta">
          <span>{post.author}</span>
          <time datetime={post.publishedAt}>{post.date}</time>
          <span>{post.readTime}</span>
        </div>
      </div>
    </header>

    <div class="shell article-stage">
      <figure class="article-cover">
        {post.thumbnail ? (
          <img src={post.thumbnail} alt="" loading="eager" decoding="async" />
        ) : (
          <div class="article-cover__fallback" aria-hidden="true">DMG</div>
        )}
      </figure>

      <div class="article-layout">
        <aside class="article-rail" aria-label="Article information">
          <div class="article-rail__block">
            <p class="article-rail__label">Published</p>
            <time datetime={post.publishedAt}>{post.date}</time>
            <span>{post.readTime}</span>
          </div>
          <div class="article-rail__block">
            <p class="article-rail__label">Share</p>
            <a
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}
              target="_blank"
              rel="noopener noreferrer">LinkedIn ↗</a
            >
            <a
              href={`https://twitter.com/intent/tweet?text=${shareTitle}&url=${shareUrl}`}
              target="_blank"
              rel="noopener noreferrer">X / Twitter ↗</a
            >
            <a href={`mailto:?subject=${shareTitle}&body=${shareUrl}`}>Email ↗</a>
          </div>
          <div class="article-rail__block">
            <a href="/insights">← All insights</a>
          </div>
        </aside>

        <div id="article-content" class="article-body" set:html={post.contentHtml} />

        <aside class="article-aside">
          <p>
            <strong>DMG Insights</strong>
            Research and company updates from DMG Blockchain Solutions, a Canadian digital
            infrastructure and blockchain technology company.
          </p>
        </aside>
      </div>
    </div>
  </article>

  <section class="related-section" aria-labelledby="related-heading">
    <div class="shell">
      <div class="section-heading">
        <h2 id="related-heading">Continue reading.</h2>
        <a href="/insights">View all insights →</a>
      </div>
      <div class="insight-grid">
        {relatedPosts.map((relatedPost) => <InsightCard post={relatedPost} />)}
      </div>
    </div>
  </section>

  <section class="article-signoff" aria-labelledby="signoff-title">
    <div class="shell">
      <h2 id="signoff-title">Building infrastructure for what comes next.</h2>
      <a class="blueprint-button" href="/#contact">Contact the DMG team</a>
    </div>
  </section>
</SiteLayout>
